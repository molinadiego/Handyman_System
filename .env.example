# Copy this template to a local environment file and replace placeholders locally.
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173

# Placeholder only. Neon: pooled URL for app traffic, direct URL for Prisma migrations.
# For local PostgreSQL, both variables may use the same local connection string.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST-pooler:5432/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR_NEON_HOST:5432/DB?sslmode=require

# Configure locally after verifying your sender domain in Resend.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Handy System <no-reply@your-domain.example>

# Generate a local 32-byte base64 key for application-level AES-256-GCM lockbox encryption.
LOCKBOX_ENCRYPTION_KEY=replace-with-a-locally-generated-32-byte-base64-key
